# ==============================================================================
# Murideen — variables d'environnement (exemple)
# Copiez ce fichier en ".env" et remplissez les vraies valeurs.
# Ne commitez JAMAIS le fichier ".env" réel.
# ==============================================================================

# --- Base de données PostgreSQL ---
DB_HOST=db
DB_PORT=5432
DB_NAME=murideen
DB_USER=murideen
DB_PASSWORD=changeme_demo_password

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Sécurité / JWT ---
JWT_SECRET=demo_super_secret_key_change_me_in_production_min_32_chars
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# --- Stockage images Cloudflare R2 (compatible S3) ---
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=murideen-media-demo
R2_ACCESS_KEY_ID=demo_access_key
R2_SECRET_ACCESS_KEY=demo_secret_key
R2_PUBLIC_BASE_URL=https://media.murideen-demo.com

# --- Passerelle de paiement (CinetPay par défaut, PayDunya alternative) ---
PAYMENT_PROVIDER=CINETPAY
CINETPAY_API_KEY=demo_cinetpay_api_key
CINETPAY_SITE_ID=demo_site_id
CINETPAY_SECRET_KEY=demo_cinetpay_secret
PAYDUNYA_MASTER_KEY=demo_paydunya_master_key
PAYDUNYA_PRIVATE_KEY=demo_paydunya_private_key
PAYDUNYA_PUBLIC_KEY=demo_paydunya_public_key
PAYDUNYA_TOKEN=demo_paydunya_token

# --- Notifications e-mail (SMTP) ---
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USERNAME=demo_smtp_user
SMTP_PASSWORD=demo_smtp_password
SMTP_FROM=Murideen <boutique@murideen-demo.com>

# --- Notifications WhatsApp/SMS (point d'intégration à finaliser) ---
WHATSAPP_PROVIDER_API_KEY=

# --- URLs publiques ---
PUBLIC_SITE_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8080
# URL de l'API telle qu'appelée depuis le NAVIGATEUR (composants client) — figée au build du frontend.
NEXT_PUBLIC_API_URL=http://localhost:8080
# URL de l'API telle qu'appelée depuis le SERVEUR Next.js à l'intérieur de Docker (composants serveur).
# En local avec docker compose, c'est le nom du service backend sur le réseau interne.
API_URL=http://backend:8080

# --- Divers ---
SPRING_PROFILES_ACTIVE=dev
NODE_ENV=development
